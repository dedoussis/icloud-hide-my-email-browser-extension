{
  "name": "icloud-hide-my-email-browser-extension",
  "version": "1.3.0",
  "type": "module",
  "description": "Cross-browser extension enabling the usage of iCloud's Hide My Email service.",
  "license": "MIT",
  "author": "dedoussis",
  "repository": {
    "type": "git",
    "url": "https://github.com/dedoussis/icloud-hide-my-email-browser-extension.git"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "prettier:check": "prettier --check '**/*.{js,jsx,ts,tsx,json,css,scss,md}'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "fuse.js": "^6.6.2",
    "lodash.isequal": "^4.5.0",
    "lodash.startcase": "^4.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/lodash.isequal": "^4.5.6",
    "@types/lodash.startcase": "^4.4.7",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^8.3.4",
    "@wxt-dev/module-react": "^1.2.2",
    "postcss": "^8.4.16",
    "prettier": "^2.5.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "wxt": "^0.20.26"
  }
}
